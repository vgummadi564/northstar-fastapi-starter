# Supabase Dashboard -> Connect -> Session pooler / Direct connection (SSL required)
DATABASE_URL_READONLY=postgresql://northstar_reader:PASSWORD@HOST:5432/postgres?sslmode=require
# Separate privileged backend-only role: SELECT policies/definitions + INSERT/SELECT audit
DATABASE_URL_BACKEND=postgresql://northstar_backend:PASSWORD@HOST:5432/postgres?sslmode=require
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-4.1-mini
# Comma separated allowed origins. No wildcard for a public deployment.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEMO_MODE=live
